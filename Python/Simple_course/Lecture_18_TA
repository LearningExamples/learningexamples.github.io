    "print(\"--- Starting division attempt ---\")\n",
    "\n",
    "num1 = 10\n",
    "num2_input = input(\"Enter a number to divide by (or 'error' to force a TypeError): \")\n",
    "\n",
    "try:\n",
    "    # Attempt to convert input to a number and perform division\n",
    "    if num2_input.lower() == 'error':\n",
    "        # Force a TypeError for demonstration\n",
    "        result = num1 / 'invalid_type'\n",
    "    else:\n",
    "        num2 = float(num2_input)\n",
    "        result = num1 / num2\n",
    "        print(f\"Division successful. Result: {result}\")\n",
    "except ZeroDivisionError:\n",
    "    print(\"Error: Cannot divide by zero!\")\n",
    "except ValueError:\n",
    "    print(\"Error: Invalid input. Please enter a valid number.\")\n",
    "except TypeError:\n",
    "    print(\"Error: Detected invalid type for division.\")\n",
    "except Exception as e:\n",
    "    print(f\"An unexpected error occurred: {e}\")\n",
    "finally:\n",
    "    print(\"--- Division attempt finished ---\")\n"
   ]
