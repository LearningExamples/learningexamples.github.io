   "source": [
    "## 9. Exceptions and functions\n",
    "\n",
    "An exception can happen inside a function.\n",
    "If the function does not handle it, the exception propagates back to the caller.\n",
    "\n",
    "### Handy example\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b4c8830c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def divide(a, b):\n",
    "    return a / b\n",
    "\n",
    "try:\n",
    "    print(divide(10, 0))\n",
    "except ZeroDivisionError:\n",
    "    print(\"Cannot divide by zero.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1a201f76",
   "metadata": {},
   "source": [
    "### Example: moving the validation logic into a function\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0cba5ade",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "tT6JPlO7TrKR",
    "outputId": "1d805dc2-76e0-4375-d820-250d9c3159a1"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Enter hours worked (or 'done' to quit): -6\n",
      "Invalid input: in the function, Hours worked cannot be negative.. Please enter a non-negative number for hours or 'done' to quit.\n",
      "Enter hours worked (or 'done' to quit): done\n",
      "Exiting salary calculator.\n"
     ]
    }
   ],
   "source": [
    "def calculate_salary_safe(hours, hourly_rate):\n",
    "    if hours < 0:\n",
    "        raise ValueError(\"in the function, Hours worked cannot be negative.\")\n",
    "    salary = hours * hourly_rate\n",
    "    return salary\n",
    "\n",
    "\n",
    "hourly_rate = 20\n",
    "\n",
    "while True:\n",
    "    hours_input = input(\"Enter hours worked (or 'done' to quit): \")\n",
    "\n",
    "    if hours_input.lower() == 'done' or hours_input.lower() == 'quit':\n",
    "        print(\"Exiting salary calculator.\")\n",
    "        break\n",
    "\n",
    "    try:\n",
    "        hours = float(hours_input)\n",
    "        # Call the function that might raise a ValueError\n",
    "        calculated_salary = calculate_salary_safe(hours, hourly_rate)\n",
    "        print(f\"Calculated salary: ${calculated_salary:.2f}\")\n",
    "    except ValueError as e:\n",
    "        print(f\"Invalid input: {e}. Please enter a non-negative number for hours or 'done' to quit.\")\n",
    "    except Exception as e:\n",
    "        print(f\"An unexpected error occurred: {e}\")"
   ]
  },
